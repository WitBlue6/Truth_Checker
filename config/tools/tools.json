{
    "tool_groups":{
        "mcp-tools":{
            "name": "mcp-tools",
            "description": "MCP工具",
            "tools":["use_mcp_host_tool"]
        },
        "agent-tools":{
            "name": "agent-tools",
            "description": "智能体工具",
            "tools":[]
        },
        "file-tools":{
            "name": "file-tools",
            "description": "文件工具",
            "tools":["read_file", "write_file", "append_file", "list_files"]
        },
        "command-tools":{
            "name": "command-tools",
            "description": "命令工具",
            "tools":["ripgrep", "execute_command"]
        },
        "task-tools":{
            "name": "task-tools",
            "description": "任务工具",
            "tools":["add_task", "update_task_status", "get_task_list"]
        },
        "api-tools":{
            "name": "api-tools",
            "description": "需要调用API的第三方工具",
            "tools":["tavily_search"]
        }
    },
    "tools":{
        "use_mcp_host_tool":{
            "name": "use_mcp_host_tool",
            "description": "使用MCP工具",
            "instruction": "使用MCP工具来执行指定的操作",
            "group": "mcp-tools",
            "params":{
                "timeout": 30000
            }
        },
        "read_file":{
            "name": "read_file",
            "description": "读取文件内容",
            "instruction": "读取指定文件的内容",
            "group": "file-tools",
            "params":{
                "timeout": 5000
            }
        }
        ,
        "write_file":{
            "name": "write_file",
            "description": "写入文件内容",
            "instruction": "将内容写入指定文件",
            "group": "file-tools",
            "params":{
                "timeout": 5000
            }
        },
        "append_file":{
            "name": "append_file",
            "description": "追加文件内容",
            "instruction": "将内容追加到指定文件末尾",
            "group": "file-tools",
            "params":{
                "timeout": 5000
            }
        },
        "list_files":{
            "name": "list_files",
            "description": "列出目录内容",
            "instruction": "列出指定目录下的文件和子目录",
            "group": "file-tools",
            "params":{
                "timeout": 5000
            }
        },
        "add_task":{
            "name": "add_task",
            "description": "添加任务",
            "instruction": "添加一个新任务",
            "group": "task-tools",
            "params":{
                "timeout": 5000
            }
        },
        "update_task_status":{
            "name": "update_task_status",
            "description": "更新任务状态",
            "instruction": "更新指定任务的状态",
            "group": "task-tools",
            "params":{
                "timeout": 5000
            }
        },
        "get_task_list":{
            "name": "get_task_list",
            "description": "获取任务列表",
            "instruction": "获取所有任务的列表",
            "group": "task-tools",
            "params":{
                "timeout": 5000
            }
        },
        "ripgrep":{
            "name": "ripgrep",
            "description": "ripgrep搜索",
            "instruction": "使用ripgrep搜索指定目录下的文件内容",
            "group": "command-tools",
            "params":{
                "timeout": 5000
            }
        },
        "execute_command":{
            "name": "execute_command",
            "description": "执行命令",
            "instruction": "执行指定的shell命令",
            "group": "command-tools",
            "params":{
                "timeout": 5000
            }
        },
        "tavily_search":{
            "name": "tavily_search",
            "description": "Tavily搜索",
            "instruction": "使用Tavily搜索指定的查询或读取链接内容",
            "group": "api-tools",
            "params":{
                "timeout": 5000
            }
        }
    }
}